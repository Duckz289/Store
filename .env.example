# PostgreSQL container settings. Copy to .env before running Docker Compose.
POSTGRES_DB=hungphat_commerce
POSTGRES_USER=medusa
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5433

# Short-lived, read-only product preview links. Use at least 32 random characters.
PRODUCT_PREVIEW_SECRET=replace-with-a-long-random-preview-secret
