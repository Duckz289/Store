{
  "name": "dtc-starter-monorepo",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel -r run dev",
    "build": "corepack pnpm -r run build",
    "start": "corepack pnpm --parallel -r run start",
    "lint": "corepack pnpm -r run lint",
    "typecheck": "corepack pnpm -r run typecheck",
    "test": "corepack pnpm --filter @dtc/backend run test:unit",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/smoke-commerce.ps1",
    "test:checkout-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/smoke-checkout.ps1",
    "backend:seed": "corepack pnpm --filter @dtc/backend run seed",
    "backend:dev": "corepack pnpm --filter @dtc/backend run dev",
    "admin:dev": "corepack pnpm --filter @dtc/admin run dev",
    "storefront:dev": "corepack pnpm --filter @dtc/storefront run dev",
    "security:audit:export": "node ./scripts/security/export-pnpm-audit.mjs"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "@babel/core@>=7.0.0 <=7.29.0": "7.29.6",
      "@opentelemetry/core@>=2.0.0 <2.8.0": "2.9.0",
      "axios@>=1.0.0 <1.18.0": "1.19.0",
      "body-parser@>=1.20.0 <1.20.6": "1.20.6",
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "immutable@>=3.0.0 <3.8.3": "3.8.3",
      "lodash@>=4.0.0 <4.18.0": "4.18.1",
      "path-to-regexp@>=0.1.0 <0.1.13": "0.1.13",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.5",
      "postcss@>=8.4.43 <=8.5.22": "8.5.25",
      "protobufjs@>=7.0.0 <7.6.5": "7.6.5",
      "qs@>=6.14.0 <6.14.2": "6.14.2",
      "rollup@>=4.0.0 <4.59.0": "4.62.4"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.18.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
