{
  "name": "dtc-starter-monorepo",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel -r run dev",
    "build": "corepack pnpm -r run build",
    "start": "corepack pnpm --parallel -r run start",
    "lint": "corepack pnpm -r run lint",
    "test": "corepack pnpm --filter @dtc/backend run test:unit",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/smoke-commerce.ps1",
    "backend:seed": "corepack pnpm --filter @dtc/backend run seed",
    "backend:dev": "corepack pnpm --filter @dtc/backend run dev",
    "storefront:dev": "corepack pnpm --filter @dtc/storefront run dev"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.18.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
